#!/bin/sh
# Regenerates every committed baseline with the environment CI checks them in.
#
#   ./updateBaselines              all baselines: yarn locks, dependency guard, verification metadata,
#                                  API dumps
#   ./updateBaselines --deps-only  only what a dependency change moves: yarn locks, dependency guard,
#                                  verification metadata (the Dependabot workflow runs this)
#   --dry-run                      configure everything, change nothing (CI runs this so a configuration-time
#                                  break of the regen fails on its own change, not at the next update)
#
# Never stops Gradle daemons: on a shared machine `./gradlew --stop` kills every other build.
set -eu

deps_only=false
dry_run=""
for arg in "$@"; do
  case "$arg" in
    --deps-only) deps_only=true ;;
    --dry-run) dry_run="--dry-run" ;;
    *) echo "Unknown option: $arg (expected --deps-only and/or --dry-run)" >&2; exit 2 ;;
  esac
done

# The deletes and ./gradlew below are relative paths: run from the repository root whatever the caller's cwd.
cd "$(dirname "$0")"

# Only macOS builds the Apple test and link tasks; elsewhere their artefacts would silently go unpinned and every
# strict CI job would then fail. A dry run writes nothing, so CI may run it on any host.
if [ -z "$dry_run" ] && [ "$(uname -s)" != Darwin ]; then
  echo "Run ./updateBaselines on macOS (or pass --dry-run): other hosts miss the Apple-target artefacts." >&2
  exit 2
fi

# Caching and configuration cache off, incremental off: baselines must come from a clean computation.
# RELEASE=true: the API dump CI publishes differs from a debug-mode dump.
# GRADLE_OPTS is replaced, not extended, so the regen does not depend on the caller's environment.
export CI=true
export RELEASE=true
export GRADLE_OPTS="-Dorg.gradle.caching=false -Dorg.gradle.configuration-cache=false -Dorg.gradle.logging.stacktrace=all -Dkotlin.incremental=false"

if [ -z "$dry_run" ]; then
  # KGP keeps build/js/package.json UP-TO-DATE when only yarn resolutions change, so the lock upgrade would
  # silently keep the old versions. Deleting the generated npm projects drops their stale files; --rerun-tasks
  # below makes the producers write them again.
  rm -rf build/js build/wasm
  # Gradle's metadata writer only appends: entries for versions no longer used would stay forever, so the file is
  # deleted and rebuilt. An interrupted or failed run (a task failure, Ctrl-C, another session stopping the shared
  # daemon) would leave it truncated and easy to commit, so any non-zero exit puts back the file as it was before
  # the run (uncommitted edits included).
  metadata_backup=$(mktemp)
  cp gradle/verification-metadata.xml "$metadata_backup"
  restore_metadata_on_failure() {
    status=$?
    if [ "$status" -ne 0 ]; then
      cp "$metadata_backup" gradle/verification-metadata.xml
      echo "updateBaselines failed (exit $status): gradle/verification-metadata.xml restored;" \
        "other baselines may be partly updated." >&2
    fi
    rm -f "$metadata_backup"
  }
  trap restore_metadata_on_failure EXIT
  # A signal does not run the EXIT trap in every sh; turning it into an exit does.
  trap 'exit 130' INT
  trap 'exit 143' TERM
  rm -f gradle/verification-metadata.xml
fi

baseline_tasks="dependencyGuardBaseline kotlinUpgradeYarnLock kotlinStoreYarnLock kotlinWasmUpgradeYarnLock kotlinWasmStoreYarnLock"
if [ "$deps_only" = false ]; then
  baseline_tasks="$baseline_tasks apiDump"
fi
# Every baseline producer runs, whatever Gradle's history says: a stale up-to-date output yields an API dump that
# differs from CI's, and the npm-project producers have been seen UP-TO-DATE right after the delete above, which
# skipped the Wasm yarn install and failed the lock tasks.
rerun="--rerun-tasks"

# Both invocations write verification metadata: settings.gradle.kts fails a CI=true build that neither verifies
# strictly nor writes metadata, and the second invocation covers the full CI graph. The second runs `build` WITH tests
# (test-only configurations must resolve; -DDISABLE_TESTS drops them) and checks the fresh baselines;
# cyclonedxBom reaches SBOM-only transitive POMs; resolveCrossHostToolchains downloads the other CI hosts'
# Kotlin/Native, Node and Binaryen archives, which this host's build never fetches; dokkaGeneratePublicationHtml
# resolves the Dokka generator that only release builds run (their javadoc jars), so a release stays strict-clean.
# --refresh-dependencies (second invocation only, its graph contains the first's): the writer records only the
# metadata files Gradle reads, and with a warm cache it reads cached descriptors instead of parent POMs and
# imported BOMs, so those go unrecorded and a cold-cache CI build fails strict verification on them. Refreshing
# re-reads every metadata file (artefacts whose checksum is unchanged are not downloaded again).
# shellcheck disable=SC2086
./gradlew --write-verification-metadata sha256 $baseline_tasks $rerun $dry_run -Pci --console=plain --continue
# shellcheck disable=SC2086
./gradlew --write-verification-metadata sha256 --refresh-dependencies build cyclonedxBom resolveCrossHostToolchains dokkaGeneratePublicationHtml $dry_run -Pci --console=plain --continue

if [ -n "$dry_run" ]; then
  rm -f gradle/verification-metadata.dryrun.xml
fi
